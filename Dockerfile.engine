FROM python:3.12-slim AS verify
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY . .
RUN python scripts/validate_repository.py
RUN python -m unittest discover -s tests -v

FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 ENGINE_BIND_HOST=0.0.0.0
COPY --from=verify /app/runtime/ runtime/
COPY --from=verify /app/scripts/serve_engine.py scripts/serve_engine.py
COPY --from=verify /app/career/ career/
COPY --from=verify /app/library/ library/
COPY --from=verify /app/foundation/ foundation/
COPY --from=verify /app/docs/ docs/
CMD ["python", "scripts/serve_engine.py"]
