FROM python:3.12-slim AS verify
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY . .
# Generated views are rebuilt inside the build image first (the user's choice D, October 2026): the engine reads only
# canonical records, so a stale page in the commit never blocks a deploy; every other check below still runs.
RUN python scripts/write_back_results.py --write && python scripts/update_player_reports.py
RUN python scripts/validate_repository.py
RUN python scripts/run_tests.py

FROM python:3.12-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 ENGINE_BIND_HOST=0.0.0.0
COPY --from=verify /app/runtime/ runtime/
COPY --from=verify /app/scripts/serve_engine.py scripts/serve_engine.py
COPY --from=verify /app/career/ career/
COPY --from=verify /app/library/ library/
COPY --from=verify /app/foundation/ foundation/
COPY --from=verify /app/docs/ docs/
CMD ["python", "scripts/serve_engine.py"]
