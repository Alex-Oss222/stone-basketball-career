diff --git a/career/Dwyane_Wade/2004-05/09_Draft/draft_order_2005.json b/career/Dwyane_Wade/2004-05/09_Draft/draft_order_2005.json
index 29a7342cb77..60a7ef68a55 100644
--- a/career/Dwyane_Wade/2004-05/09_Draft/draft_order_2005.json
+++ b/career/Dwyane_Wade/2004-05/09_Draft/draft_order_2005.json
@@ -3,7 +3,7 @@
  "kind": "draft_order",
  "draft": "2005 NBA Draft",
  "lottery_date": "2005-05-24",
- "rule": "On the lottery date the 13 clubs that missed the simulated playoffs are seeded by their simulated records (worst\nfirst); an exact tie in record is ordered by an engine drawing. Picks 1 to 3 are three engine draws, each weighted by\nthe lottery combinations of the clubs not yet drawn (tied clubs split their seeds' combinations; a drawing orders\nthem and takes any remainder) (`library/2004/league/nba_2004_lottery_rules.json`). Charlotte,\nthe expansion club, holds No. 4 in each round and is not in the lottery. The other lottery clubs take picks 5 to 14\nin seed order; the playoff clubs take the rest of the first round by record, worst first (Minnesota's first-round pick\nis forfeited by a pre-career sanction); the second round runs in reverse record of all 29 clubs, Charlotte at No. 33.\nEvery chance answer is an engine draw, journaled and never re-rolled. Pick ownership follows\n`library/2004/league/nba_2004_pick_ownership.json`. The result is `09_Draft/draft_order_2004.json`.\n\nEvery later draft (R5, October 2026) runs the same way from its own year's files (`library/<year>/league/\nnba_<year>_lottery_rules.json` and `nba_<year>_pick_ownership.json`), its season's simulated record and playoff field,\ninto `career/Dwyane_Wade/<season>/09_Draft/draft_order_<year>.json`: every non-playoff club enters the lottery unless\nthe ownership file fixes an expansion slot, a club the rules file makes ineligible for a pick (`ineligible`:\n{code: [picks]}) is left out of that pick's draw, and forfeited picks are skipped.",
+ "rule": "On the lottery date the 14 clubs that missed the simulated 2004-05 playoffs are seeded by their simulated records\n(worst first); an exact tie in record is ordered by an engine drawing. Picks 1 to 3 are three engine draws, each\nweighted by the lottery combinations of the clubs not yet drawn (tied clubs split their seeds' combinations; a\ndrawing orders them and takes any remainder) (`library/2005/league/nba_2005_lottery_rules.json`). Charlotte, the\nexpansion club, enters the lottery like any other non-playoff club; no slot is fixed. The other lottery clubs take\npicks 4 to 14 in seed order; the playoff clubs take the rest of the first round by record, worst first (no pick is\nforfeited); the second round runs in reverse record of all 30 clubs. Every chance answer is an engine draw,\njournaled and never re-rolled. Pick ownership follows `library/2005/league/nba_2005_pick_ownership.json`, and\nMiami's pick ledger for a pick simulated Miami traded. The result is `09_Draft/draft_order_2005.json`. Second-round\npicks given on the 2004 draft night stay with their clubs (the draft-night seconds are conveyed from the 2006\ndraft).",
  "lottery_seeds": [
   {
    "seed": 1,
